{
  "name": "mneme-dual-boot",
  "version": "0.1.0",
  "description": "Verified handoff for a single SQLite database kept on a shared volume that two operating systems take turns mounting. Field notes, protocol spec, recovery runbook, and a zero-dependency reference implementation.",
  "license": "MIT",
  "author": "strange2000",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/strange2000/mneme-dual-boot.git"
  },
  "homepage": "https://github.com/strange2000/mneme-dual-boot#readme",
  "bin": {
    "mneme-dual-boot": "./handoff.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "exfat",
    "sqlite",
    "dual-boot",
    "handoff",
    "integrity-check",
    "crash-recovery"
  ],
  "files": [
    "handoff.mjs",
    "docs/",
    "lab/",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "selftest": "node lab/handoff-selftest.mjs",
    "probe": "node lab/exfat-probe.mjs",
    "crash-probe": "node lab/crash-probe.mjs"
  }
}
